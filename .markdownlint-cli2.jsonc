{
  // Markdown lint rules for the course text.
  "config": {
    "default": true,
    // Prose lines are not wrapped, so line length does not apply.
    "MD013": false,
    // Collapsible answers use <details> and <summary>.
    "MD033": { "allowed_elements": ["details", "summary", "br"] },
    // The same sub-heading (for example "Sources") can appear in several sections.
    "MD024": { "siblings_only": true },
    // Ordered lists use 1. 2. 3.
    "MD029": { "style": "ordered" }
  },
  // The archived lessons are HTML and are kept unchanged.
  "ignores": ["node_modules/**"]
}
