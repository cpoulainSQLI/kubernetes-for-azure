# Hosting of the website: values to read after terraform apply.

output "default_host_name" {
  description = "Hostname of the website, generated by Azure."
  value       = azurerm_static_web_app.site.default_host_name
}

output "deployment_token" {
  description = "Deployment token of the website, for the AZURE_STATIC_WEB_APPS_API_TOKEN secret of the repository. Pipe it to gh secret set, never print it."
  value       = azurerm_static_web_app.site.api_key
  sensitive   = true
}
