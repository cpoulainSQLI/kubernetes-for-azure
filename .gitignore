# The deployment writes assets/kit.js with the account that hosts the lab kit. It is never committed.
assets/kit.js
# The pages that the deployment collects.
_site/

# Learner settings belong to the lab kit. Git ignores a stray copy here.
.env

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Tools used by the checks
node_modules/
__pycache__/

# Terraform working files of the hosting (infra/). The state holds the deployment token of the site, so it lives
# in a local file under the user profile, outside this repository. Git ignores any state or variables file here.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
crash.log

# Notes passed from one working session to the next, and the local instructions and working files of a coding agent.
# They stay on the author's machine.
handoff/
CLAUDE.md
CLAUDE.local.md
.claude/
